+    /// @dev Forward fee to karma-economy FeeBridge. Returns 0 when unset / free mode.
+    function _collectEconomyFee(
+        uint256 bindingId,
+        address token,
+        address buyer,
+        address seller,
+        address developer,
+        uint256 amountUsdc
+    ) internal returns (uint256 fee) {
+        if (feeBridge == address(0) || amountUsdc == 0) return 0;
+
+        // quoteFee(address,uint256)
