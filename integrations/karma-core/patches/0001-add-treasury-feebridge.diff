+                bytes4(keccak256("collectAndRecord(bytes32,address,address,address,uint256,uint256)")),
+                bytes32(bindingId),
+                buyer,
+                seller,
+                developer,
+                amountUsdc,
+                fee
+            )
+        );
+        if (!cOk) revert TransferFailed();
+    }
