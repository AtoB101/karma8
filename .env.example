MAINNET_RPC_URL=
CHAIN_ID=11155111

# --- External / main-repo ---
USDC_ADDRESS=
# KarmaBilateral on AtoB101/Karma (FeeBridge.core). Alias of KARMA_BILATERAL.
KARMA_CORE_ADDRESS=
KARMA_BILATERAL=
UNISWAP_ROUTER=0x0000000000000000000000000000000000000000

# --- Deployed economy addresses (清单 A — 阻塞联调) ---
TREASURY_ADDRESS=
FEE_BRIDGE_ADDRESS=
SETTLEMENT_MIRROR_ADDRESS=
STAKE_ADDRESS=
GOVERNOR_ADDRESS=
DEVELOPER_POOL_ADDRESS=
STAKER_POOL_ADDRESS=
VERIFIER_POOL_ADDRESS=
CONTRIBUTION_NFT_ADDRESS=
CONTRIBUTOR_REGISTRY_ADDRESS=
CONTRIBUTION_LEDGER_ADDRESS=
COCREATION_SCORE_VIEW_ADDRESS=
KARMA_TOKEN_ADDRESS=
CORE_ESCROW_ADAPTER_ADDRESS=
ARBITRATOR_ADDRESS=

# WireKarmaCore.s.sol
# SET_CORE=true
# VERIFY_ONLY=false

# --- MiniApp embed (D) ---
# Public origin of this frontend (main BFF sets KARMA8_ECONOMY_HOST to the same host)
KARMA8_ECONOMY_HOST=https://economy.example.com
# Comma-separated origins allowed to iframe / CORS this app
MINIAPP_ORIGIN=https://miniapp.example.com,https://web.telegram.org,https://webk.telegram.org,https://webz.telegram.org

# --- Cold start (F) — documented defaults; on-chain switch via Governor ---
# enableRevenueMode=false → FeeBridge.quoteFee=0 but collectAndRecord still mirrors GMV
# FEE_BPS constant = 20 (0.2%); do not ask main repo to change

# 7/7 Multisig owners
# seats: founder0, founder1, ecosystem0, ecosystem1, verifier0, verifier1, community0
MSIG_OWNER_0=
MSIG_OWNER_1=
MSIG_OWNER_2=
MSIG_OWNER_3=
MSIG_OWNER_4=
MSIG_OWNER_5=
