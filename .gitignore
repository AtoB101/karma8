# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/
node_modules/
frontend/node_modules/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Forge doc book output (keep project docs/)
docs/book/

# Local deployment artifacts (keep schema + examples)
deployments/*.json
!deployments/.gitkeep
!deployments/*.schema.json
!deployments/*.example.json

# Dotenv file
.env
.env.*
!.env.example
!frontend/.env.example
frontend/.env.local
frontend/dist/
